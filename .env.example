# Supabase project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
# Supabase service role key. SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Empty = mock AI (UI shows a "Demo AI" badge).
ANTHROPIC_API_KEY=
# Anthropic model used for triage and verification.
ANTHROPIC_MODEL=claude-sonnet-5-5
# lat,lng for the map and seed script. Replace with your campus or city.
NEXT_PUBLIC_MAP_CENTER=16.5062,80.6480
# Merge radius in metres for duplicate reports.
DEDUPE_RADIUS_M=30
# Protects assign and resolve. Put the demo passcode in the README for judges.
ADMIN_PASSCODE=change-me
